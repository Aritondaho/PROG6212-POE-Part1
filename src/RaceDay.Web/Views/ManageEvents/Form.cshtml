@model EventFormViewModel
@{
    var banner = Images.Resolve(Model.CurrentBannerUrl);
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a asp-action="Index">Manage events</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(Model.IsEdit ? "Edit" : "Create")</li>
    </ol>
</nav>

<div class="rd-page-header">
    <div>
        <div class="rd-eyebrow">Organiser</div>
        <h1>@(Model.IsEdit ? "Edit event" : "Create event")</h1>
    </div>
    @if (Model.IsEdit)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-rd-outline" asp-controller="Categories" asp-action="Index" asp-route-eventId="@Model.EventId">Categories</a>
            <a class="btn btn-rd-outline" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">View public page</a>
        </div>
    }
</div>

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="rd-card rd-card-body">
                <h2 class="h3 mb-3">Event details</h2>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Soweto Sunrise 10km" />
                        <span asp-validation-for="Name"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Route, start point, what to expect on the day"></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" type="datetime-local" class="form-control" />
                        <span asp-validation-for="Date"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Cape Town, Western Cape" />
                        <span asp-validation-for="Location"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.01" min="0.01" max="999.99" class="form-control" />
                        <span asp-validation-for="Distance"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select">
                            @foreach (var type in RaceDayValues.EventTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                        <span asp-validation-for="EventType"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="rd-card rd-card-body">
                <h2 class="h3 mb-3">Banner image</h2>
                <div id="banner-preview" class="rd-banner mb-3 rounded-3 @(banner is null ? "rd-banner-placeholder" : "")"
                     style="@(banner is null ? "" : $"background-image:url('{banner}')")">
                    @if (banner is null)
                    {
                        <i class="bi bi-image"></i>
                    }
                </div>
                <label asp-for="Banner" class="form-label">@(banner is null ? "Upload a banner" : "Replace the banner")</label>
                <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" data-preview="banner-preview" />
                <div class="form-text">JPEG, PNG or WebP up to 5 MB. A wide image (about 1600 × 500) looks best. It's stored in Azure Blob Storage through the RaceDay API.</div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-rd-primary px-4">@(Model.IsEdit ? "Save changes" : "Create event")</button>
        <a class="btn btn-rd-outline" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
