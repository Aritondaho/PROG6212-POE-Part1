@model List<EnrolmentItem>
@{
    var upcoming = Model.Where(en => Ui.IsUpcoming(en.EventDate)).ToList();
    var past = Model.Where(en => !Ui.IsUpcoming(en.EventDate)).OrderByDescending(en => en.EventDate).ToList();
}

<div class="rd-page-header">
    <div>
        <div class="rd-eyebrow">Participant</div>
        <h1>My events</h1>
    </div>
    <a class="btn btn-rd-primary" asp-controller="Events" asp-action="Index"><i class="bi bi-plus-lg"></i> Enter another event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="rd-card rd-stat">
            <div class="rd-stat-icon"><i class="bi bi-ticket-perforated"></i></div>
            <div><div class="rd-stat-value">@Model.Count</div><div class="rd-stat-label">Total entries</div></div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="rd-card rd-stat">
            <div class="rd-stat-icon" style="background:var(--rd-confirmed-bg);color:var(--rd-confirmed)"><i class="bi bi-check-circle"></i></div>
            <div><div class="rd-stat-value">@Model.Count(en => en.Status == "Confirmed")</div><div class="rd-stat-label">Confirmed</div></div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="rd-card rd-stat">
            <div class="rd-stat-icon" style="background:var(--rd-pending-bg);color:var(--rd-pending)"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="rd-stat-value">@Model.Count(en => en.Status == "Pending")</div><div class="rd-stat-label">Awaiting confirmation</div></div>
        </div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="rd-card rd-empty">
        <i class="bi bi-flag"></i>
        <h3>No entries yet</h3>
        <p>Find an event you like and enter it in a few clicks.</p>
        <a class="btn btn-rd-primary" asp-controller="Events" asp-action="Index">Browse upcoming events</a>
    </div>
}
else
{
    foreach (var (title, rows, empty) in new[] { ("Coming up", upcoming, "You have no upcoming events."), ("Past events", past, "No past events yet.") })
    {
        <section class="rd-card mb-4">
            <div class="rd-card-body pb-2"><h2 class="h3 mb-0">@title</h2></div>
            @if (rows.Count == 0)
            {
                <p class="rd-muted px-4 pb-4 mb-0">@empty</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rd-table">
                        <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Entered on</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var en in rows)
                            {
                                <tr>
                                    <td class="fw-semibold">@en.EventName</td>
                                    <td>@Ui.Date(en.EventDate) <span class="small rd-muted d-block">@Ui.Countdown(en.EventDate)</span></td>
                                    <td>@en.CategoryName</td>
                                    <td class="rd-muted">@Ui.Date(en.RegistrationDate)</td>
                                    <td><span class="@Ui.StatusBadgeClass(en.Status)"><i class="bi @Ui.StatusIcon(en.Status)"></i>@en.Status</span></td>
                                    <td class="text-end"><a class="btn btn-sm btn-rd-outline" asp-controller="Events" asp-action="Details" asp-route-id="@en.EventID">Details</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}
