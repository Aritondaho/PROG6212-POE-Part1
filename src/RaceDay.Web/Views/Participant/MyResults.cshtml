@model List<ResultItem>
@{
    var best = Model.MinBy(r => r.FinishPosition);
}

<div class="rd-page-header">
    <div>
        <div class="rd-eyebrow">Participant</div>
        <h1>My results</h1>
        <p class="rd-muted mb-0">Your race history across all completed events. Results appear once the organiser publishes them.</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="rd-card rd-empty">
        <i class="bi bi-trophy"></i>
        <h3>No results yet</h3>
        <p>When an event you entered is over and the organiser captures the results, your time and position appear here.</p>
        <a class="btn btn-rd-outline" asp-action="MyEvents">View my events</a>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="rd-card rd-stat">
                <div class="rd-stat-icon"><i class="bi bi-flag-fill"></i></div>
                <div><div class="rd-stat-value">@Model.Count</div><div class="rd-stat-label">Races finished</div></div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="rd-card rd-stat">
                <div class="rd-stat-icon"><i class="bi bi-award-fill"></i></div>
                <div><div class="rd-stat-value">@Ui.Ordinal(best!.FinishPosition)</div><div class="rd-stat-label">Best finish (@best.EventName)</div></div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="rd-card rd-stat">
                <div class="rd-stat-icon"><i class="bi bi-stopwatch-fill"></i></div>
                <div><div class="rd-stat-value">@Ui.FinishTime(new TimeSpan(Model.Sum(r => r.FinishTime.Ticks)))</div><div class="rd-stat-label">Total time on course</div></div>
            </div>
        </div>
    </div>

    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold"><a asp-controller="Events" asp-action="Details" asp-route-id="@r.EventID" class="text-reset">@r.EventName</a></td>
                            <td>@Ui.Date(r.EventDate)</td>
                            <td>@r.CategoryName</td>
                            <td class="rd-time">@Ui.FinishTime(r.FinishTime)</td>
                            <td>
                                <span class="rd-position">@Ui.Ordinal(r.FinishPosition)</span>
                                <small>out of @r.TotalFinishers finisher@(r.TotalFinishers == 1 ? "" : "s")</small>
                                @if (r.FinishPosition <= 3)
                                {
                                    <i class="bi bi-trophy-fill ms-1" style="color:var(--rd-orange)" title="Podium finish"></i>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
