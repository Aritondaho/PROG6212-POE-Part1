@{
    var user = Context.GetCurrentUser();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty;
    var roleClass = user is null ? "role-visitor" : user.IsOrganiser ? "role-organiser" : "role-participant";
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title ? $"{title} · RaceDay" : "RaceDay")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
</head>
<body class="@roleClass">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
            <div class="container">
                <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                    <span class="rd-brand-mark"><i class="bi bi-flag-fill"></i></span>Race<span>Day</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (user?.IsOrganiser == true)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("ManageEvents")" asp-controller="ManageEvents" asp-action="Index"><i class="bi bi-calendar-event"></i> Manage events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Events")" asp-controller="Events" asp-action="Index"><i class="bi bi-globe2"></i> Public listing</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Events") @Active("Home")" asp-controller="Events" asp-action="Index"><i class="bi bi-calendar-event"></i> Upcoming events</a></li>
                            @if (user?.IsParticipant == true)
                            {
                                <li class="nav-item"><a class="nav-link @Active("Participant", "MyEvents")" asp-controller="Participant" asp-action="MyEvents"><i class="bi bi-ticket-perforated"></i> My events</a></li>
                                <li class="nav-item"><a class="nav-link @Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults"><i class="bi bi-trophy"></i> My results</a></li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (user is null)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Account", "Login")" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item"><a class="btn btn-rd-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Join RaceDay</a></li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="rd-role-pill">@user.Role</span>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (Images.Resolve(user.ProfilePictureUrl) is { } avatar)
                                    {
                                        <img src="@avatar" alt="" class="rd-avatar rd-avatar-sm" />
                                    }
                                    else
                                    {
                                        <span class="rd-avatar rd-avatar-sm rd-avatar-initials">@user.Initials</span>
                                    }
                                    <span>@user.FullName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle"></i> My profile</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
        @if (user?.IsOrganiser == true)
        {
            <div class="rd-console-bar">
                <div class="container"><i class="bi bi-clipboard-data"></i> Organiser console</div>
            </div>
        }
    </header>

    <main class="rd-main">
        @RenderSection("Hero", required: false)
        <div class="container py-4">
            <partial name="_FlashMessages" />
            @RenderBody()
        </div>
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span><strong>RaceDay</strong> · Road running, walking and cycling events across South Africa</span>
            <span>&copy; @System.DateTime.Today.Year RaceDay</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
