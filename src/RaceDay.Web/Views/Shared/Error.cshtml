@{
    ViewData["Title"] = "Something went wrong";
    var message = ViewData["Message"] as string;
    var requestId = ViewData["RequestId"] as string;
}
<div class="rd-auth">
    <div class="rd-card rd-empty">
        <i class="bi bi-exclamation-octagon"></i>
        <h1>Hit a pothole</h1>
        <p>@(string.IsNullOrWhiteSpace(message) ? "Something went wrong on our side. Your data is safe; please try again." : message)</p>
        <div class="d-flex justify-content-center gap-2">
            <a class="btn btn-rd-primary" asp-controller="Home" asp-action="Index">Back to RaceDay</a>
            <a class="btn btn-rd-outline" href="javascript:history.back()">Go back</a>
        </div>
        @if (!string.IsNullOrEmpty(requestId))
        {
            <p class="small rd-muted mt-4 mb-0">Reference: <code>@requestId</code></p>
        }
    </div>
</div>
